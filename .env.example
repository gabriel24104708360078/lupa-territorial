# APP_URL: URL pública onde a aplicação está hospedada (opcional).
APP_URL="MY_APP_URL"

# SQLITE_DB_PATH: Caminho opcional do banco SQLite local (no Vercel usa /tmp automaticamente).
SQLITE_DB_PATH="data/lupa_territorial.sqlite"

# DATABASE_URL: String de conexão PostgreSQL (ex.: Neon via Vercel Marketplace).
# Quando definida, o servidor usa PostgreSQL em vez do SQLite local.
DATABASE_URL=
